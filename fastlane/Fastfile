default_platform(:ios)

lane :increment_build do
  sh("./increment_build.sh")
end

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :build_and_upload do
    match(type: "appstore", app_identifier: ["com.unboxme.app", "com.unboxme.app.OneSignalNotificationServiceExtension"])
    build_app(workspace: "./ios/unboxme.xcworkspace", scheme: "unboxme",  clean: true, export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
    firebase_app_distribution(debug: true, app: "1:759842823698:android:0f442ba143dc90d4d602cb")
  end
end

platform :android do
  lane :build do
    gradle(
      project_dir: './android',
      task: 'bundle',
      build_type: 'Release'
    )
    gradle(
      project_dir: './android',
      task: 'assemble',
      build_type: 'Release'
    )
  end
  lane :build_and_upload do
    build()
    upload_to_play_store(track: 'internal', skip_upload_apk: true, release_status: 'draft')
  end
end

lane :release_all do
  increment_build
  sh "fastlane ios build_and_upload"
#  sh "fastlane android build_and_upload"
end
